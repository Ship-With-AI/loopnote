{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.vue"],
  "exclude": ["src/web/shims-vue.d.ts"]
}
